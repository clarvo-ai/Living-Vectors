# Get the Google OAuth credentials from Secret Manager
# https://console.cloud.google.com/security/secret-manager/secret/local-env/versions?project=swp-livingvectors
GOOGLE_CLIENT_ID=project-google-client-id
GOOGLE_CLIENT_SECRET=project-google-client-secret

NODE_ENV=development
NEXTAUTH_SECRET=your-long-secret-key-here
NEXTAUTH_URL=http://localhost:3045

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880