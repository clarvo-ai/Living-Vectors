# LiveKit Agent Environment Variables Template
# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment (DO NOT COMMIT .env.production)

# Replace with GEMINI API key from Google Cloud Console project
# https://console.cloud.google.com/apis/credentials?project=swp-livingvectors
GEMINI_API_KEY='GEMINI_API_KEY'

# LiveKit Server Configuration
# For local development: ws://127.0.0.1:7880
# For production (LiveKit Cloud): wss://your-project.livekit.cloud
LIVEKIT_URL=ws://127.0.0.1:7880

# LiveKit API Credentials
# For local: use default dev credentials
# For production: get from LiveKit Cloud dashboard (Settings → Keys)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Agent Configuration
LIVEKIT_AGENT_NAME=lv-voice-agent

# GCS Bucket
GCS_BUCKET_NAME=lv-storage

# elevenlabs API
ELEVENLABS_API_KEY=ELEVENLABS_API_KEY

OPENAI_API_KEY=OPENAI_API_KEY
INTERNAL_API_SECRET=INTERNAL_API_SECRET
BACKEND_URL=http://lv-pyapi:8080

# LangSmith tracing (optional)
# Set both to enable tracing; leave blank to disable.
# For US region:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
# For EU region:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://eu.api.smith.langchain.com/otel
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
