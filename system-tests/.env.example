# Copy this to .env.local for local development, or configure in GitHub Actions

# Frontend URL
BASE_URL=http://localhost:3045

# Skip automatic server startup (use if you have the server already running)
SKIP_SERVER_START=false

# Test user credentials (configure if different from defaults)
TEST_EMAIL=systest@livingvectors.test
TEST_PASSWORD=TestPassword123!

# Backend API URL (for direct API calls if needed)
BACKEND_URL=http://localhost:8000

# Database configuration (for CI/CD)
DATABASE_URL=postgresql://user:password@localhost:5432/lv_test

# CI/CD mode
CI=false

# GEMINI
GEMINI_API_KEY=your_gemini_api_key_here